    <div class="max-w-7xl mx-auto p-5 lg:p-10">
      <!-- Header Section -->
      <div class="text-center mb-8 lg:mb-12">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black mb-4 lg:mb-6"
          style="text-shadow: 2px 2px 0 #6F6E70, -2px -2px 0 #272425, 2px -2px 0 #272425, -2px 2px 0 #272425;"
        >
          RackaRacka Merchandise Store
        </h1>
        <p class="text-lg lg:text-xl text-gray-300 max-w-3xl mx-auto mb-6 lg:mb-8">
          Search for your favorite items and grab exclusive merch!
        </p>

        <!-- Search Bar -->
        <div class="flex justify-center">
          <div class="relative w-full max-w-md">
            <input
              id="search"
              type="text"
              placeholder="Search for products..."
              class="w-full text-[#6F6E70] placeholder-[#6F6E70] p-4 pl-12 rounded-lg border-2 border-yellow-500 bg-black focus:ring-2 focus:ring-yellow-500 focus:outline-none transition"
            />
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-2xl">🔍</span>
          </div>
        </div>
      </div>

      <!-- Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
        <!-- T-shirt1 -->
        <div class="w-full group">
          <div class="relative w-full cursor-pointer">
