---
import Layout from "../layouts/Layout.astro";
---
<Layout>
  <div class="shadow-[0_10px_30px_rgba(0,0,0,0.7),0_25px_60px_rgba(217,39,39,0.3)] rounded-lg relative w-full bg-[#272425] text-white">
    <div class="max-w-6xl mx-auto px-5 pt-5 pb-5 grid gap-5">

      <!-- 1️ Tekst + billede -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-start">
        <!-- Tekst styrer højden -->
        <p class="bg-black rounded-lg m-0 p-4 text-center text-xl md:text-3xl font-bold">
          Welcome to the RackaRacka website, here you can find all the latest news and updates about our films, projects, and events, or visit our shop to grab some exclusive merchandise!
        </p>

   <!-- Video  -->
<div class="relative bg-black overflow-hidden rounded-lg aspect-video transition duration-300 hover:scale-[1.02] sm:aspect-auto sm:h-0 sm:min-h-full block">
  <iframe
    id="promoVideo"
    class="w-full h-full object-cover"
    src="https://www.youtube.com/embed/sEAGMkIadV0?autoplay=1&mute=1&enablejsapi=1&loop=1&playlist=sEAGMkIadV0&controls=0&rel=0&modestbranding=1&showinfo=0"
    title="RackaRacka X Gucci reklamevideo"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
  ></iframe>

  <!-- Lydknap -->
  <button
    id="unmuteButton"
    class="absolute bottom-4 right-4 bg-white/20 backdrop-blur-md text-white text-sm px-4 py-2 rounded-lg border border-white/30 hover:bg-white/30 transition"
  >
    🔊 Sound on
  </button>
</div>

<script is:inline>
  const subbutton = document.getElementById("unmuteButton");
  const iframe = document.getElementById("promoVideo");
  let isMuted = true;

  subbutton.addEventListener("click", () => {
    if (isMuted) {
      iframe.contentWindow.postMessage(
        '{"event":"command","func":"unMute","args":""}',
        "*"
      );
      subbutton.textContent = "🔇";
      isMuted = false;
    } else {
      iframe.contentWindow.postMessage(
        '{"event":"command","func":"mute","args":""}',
        "*"
      );
      subbutton.textContent = "🔊";
      isMuted = true;
    }
  });
</script>
      </div>



      <!-- 2️ Stor plakat -->
      <a href="/events" class="block rounded-lg transform  transition duration-30 hover:scale-[1.02]">
        <img
          class="w-full rounded-lg"
          src="/Billeder/poster.webp"
          alt="Plakat"
        />
      </a>

        <!-- 3️ To store billeder -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <a href="/events" class="block overflow-hidden  rounded-lg transform transition duration-300 ease-in-out hover:scale-[1.02]">
          <img
            class="w-full h-full object-cover"
            src="/Billeder/event/wrestling4.png"
            alt="wrestling add"
          />
        </a>
        <a href="/events" class="block overflow-hidden  rounded-lg transform transition duration-300 ease-in-out hover:scale-[1.02]">
          <img
            class="w-full h-full object-cover"
            src="/Billeder/event/talktome.png"
            alt="talk to me add"
          />
        </a>
      </div>

      <!-- 4️ Tre mindre billeder -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <a href="/events" class="block overflow-hidden rounded-lg transform transition duration-300 ease-in-out hover:scale-[1.02]">
          <img
            class="w-full h-full object-cover"
            src="/Billeder/gucci.png"
            alt="Guuci reklame"
          />
        </a>
        <a href="https://www.youtube.com/@Therackaracka" target="_blank" rel="noopener noreferrer" class="block overflow-hidden rounded-lg transform transition duration-300 ease-in-out hover:scale-[1.02]">
          <img
            class="w-full h-full object-cover"
            src="/Billeder/youtube.png"
            alt="Billede 4"
          />
        </a>
        <a href="https://www.instagram.com/therackaracka/" target="_blank" rel="noopener noreferrer" class="block overflow-hidden  rounded-lg transform transition duration-300 ease-in-out hover:scale-[1.02]">
          <img
            class="w-full h-full object-cover"
            src="/Billeder/insta.png"
            alt="Billede 5"
          />
        </a>
      </div>

   <!-- 5️ Bundsektion -->
<div class="bg-black rounded-lg p-10 pb-24 text-center ease-in-out relative">
  <h2 class="text-2xl sm:text-3xl font-bold mb-6 tracking-wider">
    Subscribe to our emails
  </h2>

  <!-- Input + knap -->
  <div
    class="flex items-center justify-center border border-gray-500 w-full sm:w-[700px] mx-auto px-6 py-4 relative"
  >
    <input
      id="emailInput"
      type="text"
      placeholder="Email"
      class="bg-transparent text-gray-300 outline-none w-full text-xl font-light tracking-widest text-center sm:text-left"
    />
    <button
      id="subscribeButton"
      class="text-gray-300 hover:scale-[1.02] text-2xl hover:translate-x-1 transition"
    >
      →
    </button>
  </div>

  <!-- Popup besked -->
  <div
    id="popupMessage"
    class="hidden absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-green-600 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-lg transition-opacity duration-300"
  >
    Your email has been added to the list
  </div>

  <!-- subscrivbe -->
  <script>
  const subscribeButton = document.getElementById("subscribeButton");
  const popupMessage = document.getElementById("popupMessage");
  const emailInput = document.getElementById("emailInput") as HTMLInputElement; // 👈 vigtig linje

  if (subscribeButton && popupMessage && emailInput) {
    subscribeButton.addEventListener("click", () => {
      const email = emailInput.value.trim(); // ✅ virker nu

      if (email === "") {
        popupMessage.textContent = "Please enter a valid email";
        popupMessage.classList.remove("bg-green-600");
        popupMessage.classList.add("bg-red-600");
      } else {
        popupMessage.textContent = "Your email has been added to the list";
        popupMessage.classList.remove("bg-red-600");
        popupMessage.classList.add("bg-green-600");
        emailInput.value = "";
      }

      popupMessage.classList.remove("hidden");
      popupMessage.style.opacity = "1";

      setTimeout(() => {
        popupMessage.style.opacity = "0";
        setTimeout(() => popupMessage.classList.add("hidden"), 300);
      }, 3000);
    });
  }
</script>


</div>
