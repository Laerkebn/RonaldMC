---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen bg-gradient-to-b from-[#1a1718] to-[#272425] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
      
      <!-- Hero Header -->
      <div class="text-center mb-16 lg:mb-24">
        <h1
          class="text-5xl sm:text-6xl lg:text-7xl xl:text-8xl font-black mb-6"
          style="text-shadow: 3px 3px 0 #6F6E70, -2px -2px 0 #272425, 3px -2px 0 #272425, -2px 3px 0 #272425;"
        >
          RackaRacka Events
        </h1>
        <p class="text-xl lg:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
          Stay updated with our latest chaos — from haunted tours to brutal beatdowns.
        </p>
      </div>

      <!-- EVENT 1: Haunted House Tour -->
      <div class="mb-16 lg:mb-24">
        <div class="bg-gradient-to-br from-black via-[#1a1010] to-black rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.9)] border border-gray-800 hover:border-yellow-500/30 transition-all duration-500">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
            
            <!-- Image -->
            <div class="relative overflow-hidden h-[400px] lg:h-auto group">
              <img
                src="/Billeder/poster.webp"
                alt="Haunted House Tour"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent lg:opacity-80"></div>
            </div>

            <!-- Content -->
            <div class="p-8 lg:p-12 xl:p-16 flex flex-col justify-center">
              
              <h2 class="text-4xl lg:text-5xl font-bold text-yellow-500 mb-6">The Haunted House Tour</h2>
              
              <div class="space-y-4 text-lg text-gray-200 leading-relaxed mb-8">
                <p>
                  This Halloween season, <strong class="text-yellow-400">RackaRacka</strong> is taking fear on the road like never before. <strong class="text-yellow-400">The Haunted House Tour 2025</strong> kicks off <span class="font-semibold text-yellow-400">October 10</span> and runs until <span class="font-semibold text-yellow-400">November 2</span>, spreading terror across Australia's major cities.
                </p>

                <p>
                  The tour begins in <span class="italic text-gray-300">Sydney</span> at the abandoned <span class="font-semibold text-yellow-400">Wickham Warehouse</span>, before moving through <span class="italic text-gray-300">Melbourne, Brisbane, Adelaide,</span> and <span class="italic text-gray-300">Perth</span>. Each location features a uniquely designed haunted maze inspired by our latest movie <strong class="font-semibold text-yellow-400">Bring Her Back</strong>.
                </p>

                <p>
                  Step inside if you dare — blood, chaos, and twisted surprises await. Witness <strong class="text-yellow-400">live performances</strong>, <strong class="text-yellow-400">interactive horror zones</strong>, and <strong class="text-yellow-400">cinematic practical effects</strong> that will haunt your mind long after you escape.
                </p>
              </div>

              <div class="flex flex-wrap gap-4">
                <a
                  href="https://www.ticketmaster.com.au"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block bg-yellow-500 hover:bg-yellow-600 text-black font-bold py-4 px-8 rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
                >
                  🎟️ Get Tickets
                </a>
                
                <a
                  href="https://www.rackaracka.com/hauntedtour"
                  class="inline-block bg-gray-800 hover:bg-gray-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 border border-gray-600 hover:border-yellow-500"
                >
                  📅 Tour Dates
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- EVENT 2: Talk To Me 2 -->
      <div class="mb-16 lg:mb-24">
        <div class="bg-gradient-to-br from-black via-[#1a1010] to-black rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.9)] border border-gray-800 hover:border-red-500/30 transition-all duration-500">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
            
            <!-- Content (Left on Desktop) -->
            <div class="p-8 lg:p-12 xl:p-16 flex flex-col justify-center order-2 lg:order-1">
              
              <h2 class="text-4xl lg:text-5xl font-bold text-yellow-500 mb-6">
                Talk To Me 2 — Officially Announced
              </h2>
              
              <div class="space-y-4 text-lg text-gray-200 leading-relaxed mb-8">
                <p>
                  It's official — <strong class="font-semibold text-yellow-400">Talk To Me 2</strong> is happening. Following the global success and viral impact of the first film, we are thrilled to announce that a sequel of Talk to me is in the works and we aim to push the boundaries of modern horror once again.
                </p>

                <p>
                  Production is currently underway in <span class="font-semibold text-yellow-400">Australia</span>, with the original creative team returning to deliver a story that delves even deeper into the cursed universe we created.
                </p>

                <p>
                  While no official release date has been confirmed yet, Stay tuned for <strong class="font-semibold text-yellow-400">exclusive behind-the-scenes footage</strong>, <strong class="font-semibold text-yellow-400">cast announcements</strong>, and the <strong class="font-semibold text-yellow-400">first official trailer</strong> — all coming soon on our <a href="https://www.instagram.com/therackaracka/" class="text-yellow-400 underline hover:text-yellow-300 transition-colors">Instagram</a>. Expect a film that is <span class="italic">darker, bloodier, and far more unhinged</span> in a goal to once again blur the line between possession and madness.
                </p>
              </div>

              <a
                href="/news"
                class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(220,38,38,0.5)] w-fit"
              >
                📰 Read More
              </a>
            </div>

            <!-- Image (Right on Desktop) -->
            <div class="relative overflow-hidden h-[400px] lg:h-auto group order-1 lg:order-2">
              <img
                src="/Billeder/talk2me2.jpg"
                alt="Talk To Me 2 Announcement"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-l from-black/60 to-transparent lg:opacity-80"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- EVENT 3: Ronald WWE Beatdown 2 -->
      <div class="mb-16 lg:mb-24">
        <div class="bg-gradient-to-br from-black via-[#1a1010] to-black rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.9)] border border-gray-800 hover:border-yellow-500/30 transition-all duration-500">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
            
            <!-- Image -->
            <div class="relative overflow-hidden h-[400px] lg:h-auto group">
              <img
                src="/Billeder/event/wrestling4.png"
                alt="Ronald WWE Beatdown 2"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent lg:opacity-80"></div>
            </div>

            <!-- Content -->
            <div class="p-8 lg:p-12 xl:p-16 flex flex-col justify-center">

              <h2 class="text-4xl lg:text-5xl font-bold text-yellow-500 mb-6">Ronald WWE Beatdown 2</h2>
              
              <div class="space-y-4 text-lg text-gray-200 leading-relaxed mb-8">
                <p>
                  The chaos returns! After the legendary first showdown, <strong class="text-yellow-400">Ronald McDonald</strong> steps back into the ring — stronger, meaner, and twice as unhinged. This is RackaRacka's <span class="font-semibold text-yellow-400">ultimate wrestling spectacle:</span> <strong class="text-yellow-400">Ronald WWE Beatdown 2</strong>. Joining us this year of WWE Beatdown is also <span class="font-semibold text-yellow-400">Ciclope Yedra, Miedo Extremo & Rina Yamashita</span>.
                </p>

                <p>
                  Witness absolute carnage on <span class="font-semibold text-yellow-400">March 22, 2025</span> at the <span class="font-semibold text-yellow-400">Adelaide Entertainment Centre</span>, before the mayhem goes nationwide — hitting <span class="font-italic text-gray-300">Melbourne (March 29)</span>, <span class="font-italic text-gray-300">Sydney (April 5)</span>, and <span class="font-italic text-gray-300">Brisbane (April 12)</span>. Each city will host a one-night-only live brawl featuring pyrotechnics, weapons, and a crowd that's ready to scream for blood.
                </p>

                <p class="text-red-400 font-semibold">
                  ⚠️ 18+ event — enter at your own risk.
                </p>
              </div>

              <!-- Buttons -->
              <div class="flex flex-wrap gap-4 mb-8">
                <a
                  href="/tickets"
                  class="inline-block bg-yellow-500 hover:bg-yellow-600 text-black font-bold py-4 px-8 rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-[0_10px_30px_rgba(234,179,8,0.5)]"
                >
                  🎟️ Get Tickets
                </a>

                <button
                  id="showGalleryButton"
                  class="inline-block bg-gray-800 hover:bg-gray-700 text-white font-bold py-4 px-8 rounded-xl transition-all duration-300 border border-gray-600 hover:border-yellow-500"
                >
                  📸 See Latest Photos
                </button>
              </div>

              <!-- Photo Gallery (Hidden by Default) -->
              <div id="wweGallery" class="hidden">
                <div class="relative w-full overflow-hidden rounded-xl">
                  <div id="wweSlider" class="flex transition-transform duration-500 ease-in-out">
                    <img
                      src="/Billeder/wrestling4.jpeg"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 4"
                    />
                    <img
                      src="/Billeder/event/wrestling2.webp"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 2"
                    />
                    <img
                      src="/Billeder/event/wrestling3.jpeg"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 3"
                    />
                    <img
                      src="/Billeder/event/wrestling1.webp"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 1"
                    />
                    <img
                      src="/Billeder/event/ronaldkiss.jpeg"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 5"
                    />
                    <img
                      src="/Billeder/event/wrestling5.webp"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 6"
                    />
                    <img
                      src="/Billeder/event/wrestling7.jpeg"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 7"
                    />
                    <img
                      src="/Billeder/event/wrestling8.jpeg"
                      class="w-full flex-shrink-0 object-cover rounded-xl h-[350px]"
                      alt="Wrestling 8"
                    />
                  </div>

                  <!-- Navigation Arrows -->
                  <button
                    id="prevSlide"
                    class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-yellow-500 text-white px-5 py-3 rounded-full hover:scale-110 transition-all duration-300 text-xl font-bold"
                  >
                    ◀
                  </button>

                  <button
                    id="nextSlide"
                    class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/70 hover:bg-yellow-500 text-white px-5 py-3 rounded-full hover:scale-110 transition-all duration-300 text-xl font-bold"
                  >
                    ▶
                  </button>

                  <!-- Slide Indicators -->
                  <div id="slideIndicators" class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    const gallery = document.getElementById("wweGallery");
    const button = document.getElementById("showGalleryButton");
    const slider = document.getElementById("wweSlider");
    const next = document.getElementById("nextSlide");
    const prev = document.getElementById("prevSlide");
    const indicators = document.getElementById("slideIndicators");
    let index = 0;
    const slides = slider.children.length;

    // Create indicators
    for (let i = 0; i < slides; i++) {
      const dot = document.createElement("button");
      dot.className = "w-3 h-3 rounded-full bg-gray-500 hover:bg-yellow-500 transition-all duration-300";
      dot.onclick = () => goToSlide(i);
      indicators.appendChild(dot);
    }

    function updateIndicators() {
      Array.from(indicators.children).forEach((dot, i) => {
        dot.className = i === index 
          ? "w-3 h-3 rounded-full bg-yellow-500 scale-125 transition-all duration-300"
          : "w-3 h-3 rounded-full bg-gray-500 hover:bg-yellow-500 transition-all duration-300";
      });
    }

    function goToSlide(n) {
      index = n;
      slider.style.transform = `translateX(-${index * 100}%)`;
      updateIndicators();
    }

    // Toggle gallery
    button.addEventListener("click", () => {
      gallery.classList.toggle("hidden");
      button.innerHTML = gallery.classList.contains("hidden") ? "📸 See LatestPhotos" : "✖️ Hide Photos";
    });

    // Next slide
    next.addEventListener("click", () => {
      index = (index + 1) % slides;
      goToSlide(index);
    });

    // Previous slide
    prev.addEventListener("click", () => {
      index = (index - 1 + slides) % slides;
      goToSlide(index);
    });

    // Initialize
    updateIndicators();
  </script>
</Layout>