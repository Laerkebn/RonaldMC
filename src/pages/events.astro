---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="shadow-[0_10px_30px_rgba(0,0,0,0.7),0_25px_60px_rgba(217,39,39,0.3)] rounded-lg relative w-full bg-[#272425] text-white"
  >
    <div class="max-w-6xl mx-auto px-5 pt-10 pb-10 grid gap-10">
      <!-- HEADER -->
      <div class="text-center">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-black mb-4"
          style="text-shadow: 2px 2px 0 #6F6E70, -2px -2px 0 #272425, 2px -2px 0 #272425, -2px 2px 0 #272425;"
        >
          RackaRacka Events
        </h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Stay updated with our latest chaos — from haunted tours to brutal beatdowns.
        </p>
      </div>

      <!-- EVENT 1: Haunted House Tour -->
      <div class="bg-black rounded-lg p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="rounded-lg overflow-hidden">
          <img
            src="/Billeder/poster.webp"
            alt="Haunted House Tour"
            class="w-full h-full object-cover transform transition duration-300 hover:scale-[1.02]"
          />
        </div>

        <div>
          <h2 class="text-3xl font-bold text-yellow-500 mb-4">The Haunted House Tour</h2>
          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            This Halloween season, <strong>RackaRacka</strong> is taking fear on the road like never
            before.
            <strong>The Haunted House Tour 2025</strong> kicks off <span
              class="font-semibold text-yellow-400">October 10</span
            > and runs until
            <span class="font-semibold text-yellow-400">November 2</span>, spreading terror across
            Australia’s major cities.
          </p>

          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            The tour begins in <span class="italic">Sydney</span> at the abandoned <span
              class="font-semibold">Wickham Warehouse</span
            >, before moving through <span class="italic">Melbourne, Brisbane, Adelaide,</span> and <span
              class="italic">Perth</span
            >. Each location features a uniquely designed haunted maze inspired by our latest movie <strong
              class="font-semibold text-yellow-400">Bring Her Back</strong
            >.
          </p>

          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            Step inside if you dare — blood, chaos, and twisted surprises await. Witness <strong
              >live performances</strong
            >, <strong>interactive horror zones</strong>, and <strong
              >cinematic practical effects</strong
            >
            that will haunt your mind long after you escape.
          </p>

          <p class="text-lg text-gray-300 mb-6 leading-relaxed">
            <strong>Tickets</strong> go on sale <span class="font-semibold text-yellow-400"
              >September 1, 2025</span
            >.<br />
            Visit <a
              href="https://www.rackaracka.com/hauntedtour"
              class="text-yellow-400 underline hover:text-yellow-300">rackaracka.com/hauntedtour</a
            > for full tour dates, ticket packages, and age restrictions.
          </p>

          <a
            href="https://www.ticketmaster.com.au"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block bg-yellow-500 hover:bg-yellow-600 text-black font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
          >
            Get Tickets
          </a>
        </div>
      </div>

      <!-- EVENT 2: Talk To Me 2 -->
      <div class="bg-black rounded-lg p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-3xl font-bold text-yellow-500 mb-4">
            Talk To Me 2 — Officially Announced
          </h2>
          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            It’s official — <strong class="font-semibold text-yellow-400">Talk To Me 2</strong> is happening.
            Following the global success and viral impact of the first film, we are thrilled to announce
            that a sequel of Talk to me is in the works and we aim to push the boundaries of modern horror
            once again.
          </p>

          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            Production is currently underway in <span class="font-semibold text-yellow-400"
              >Australia</span
            >, with the original creative team returning to deliver a story that delves even deeper
            into the cursed universe we created.
          </p>

          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            While no official release date has been confirmed yet, Stay tuned for <strong
              class="font-semibold text-yellow-400">exclusive behind-the-scenes footage</strong
            >, <strong class="font-semibold text-yellow-400">cast announcements</strong>, and the <strong
              class="font-semibold text-yellow-400">first official trailer</strong
            > — all coming soon on our <a
              href="https://www.instagram.com/therackaracka/"
              class="text-yellow-400 underline hover:text-yellow-300">Instagrams</a
            >. Expect a film that is <span class="italic"
              >darker, bloodier, and far more unhinged</span
            > in a goal to once again blur the line between possession and madness.
          </p>
          <a
            href="/news"
            class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
          >
            Read More
          </a>
        </div>

        <div class="rounded-lg overflow-hidden">
          <img
            src="/Billeder/talk2me2.jpg"
            alt="Talk To Me 2 Announcement"
            class="w-full h-full object-cover transform transition duration-300 hover:scale-[1.02]"
          />
        </div>
      </div>

      <!-- EVENT 3: Ronald WWE Beatdown 2 -->
      <div
        class="bg-black rounded-lg p-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center relative"
      >
        <div class="rounded-lg overflow-hidden">
          <img
            src="/Billeder/event/wrestling4.png"
            alt="Ronald WWE Beatdown 2"
            class="w-full h-full object-cover transform transition duration-300 hover:scale-[1.02]"
          />
        </div>

        <div>
          <h2 class="text-3xl font-bold text-yellow-500 mb-4">Ronald WWE Beatdown 2</h2>
          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            The chaos returns! After the legendary first showdown,
            <strong>Ronald McDonald</strong> steps back into the ring — stronger, meaner, and twice as
            unhinged. This is RackaRacka’s <span class="font-semibold text-yellow-400"
              >ultimate wrestling spectacle:</span
            >
            <strong>Ronald WWE Beatdown 2</strong>.
            Joining us this year of WWE Beatdown is also <span class="font-semibold text-yellow-400">Ciclope Yedra, Miedo Extremo & Rina Yamashita</span>.
          </p>

          <p class="text-lg text-gray-300 mb-4 leading-relaxed">
            Witness absolute carnage on <span class="font-semibold text-yellow-400"
              >March 22, 2025</span
            >
            at the <span class="font-semibold text-yellow-400">Adelaide Entertainment Centre</span>, before the mayhem goes
            nationwide — hitting <span class="font-italic">Melbourne (March 29)</span>,
            <span class="font-italic">Sydney (April 5)</span>, and
            <span class="font-italic">Brisbane (April 12)</span>. Each city will host a one-night-only
            live brawl featuring pyrotechnics, weapons, and a crowd that’s ready to scream for
            blood.
          </p>

          <p class="text-lg text-gray-300 mb-6 leading-relaxed">
            🎟️ <strong>Tickets</strong> are on sale now! Don’t miss the most violent, hilarious, and
            over-the-top wrestling event of the year.
            <span class="font-semibold text-yellow-400">18+ event — enter at your own risk.</span>
          </p>

          <!-- Knapper -->
          <div class="flex gap-4 mb-6">
            <a
              href="/tickets"
              class="inline-block bg-yellow-500 hover:bg-yellow-600 text-black font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
            >
              Get Tickets
            </a>

            <button
              id="showGalleryButton"
              class="inline-block bg-gray-700 hover:bg-gray-600 text-white font-bold py-3 px-8 rounded-lg transition transform hover:scale-105"
            >
              See Photos
            </button>
          </div>

          <!-- 🖼️ Billedgalleri (skjult fra start) -->
          <div id="wweGallery" class="hidden relative w-full overflow-hidden rounded-lg">
            <div id="wweSlider" class="flex transition-transform duration-500 ease-in-out">
              <img
                src="/Billeder/event/wrestling1.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 1"
              />
              <img
                src="/Billeder/event/wrestling2.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 2"
              />
              <img
                src="/Billeder/event/wrestling3.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 3"
              />
              <img
                src="/Billeder/event/wrestling4.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 4"
              />
              <img
                src="/Billeder/event/wrestling5.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 5"
              />
              <img
                src="/Billeder/event/wrestling6.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 6"
              />
              <img
                src="/Billeder/event/wrestling7.webp"
                class="w-full flex-shrink-0 object-cover rounded-lg"
                alt="Wrestling 7"
              />
            </div>

            <!-- Venstre pil -->
            <button
              id="prevSlide"
              class="absolute left-2 top-1/2 -translate-y-1/2 bg-white/20 text-white px-3 py-2 rounded-full hover:bg-white/40 transition"
            >
              ◀
            </button>

            <!-- Højre pil -->
            <button
              id="nextSlide"
              class="absolute right-2 top-1/2 -translate-y-1/2 bg-white/20 text-white px-3 py-2 rounded-full hover:bg-white/40 transition"
            >
              ▶
            </button>
          </div>
        </div>
      </div>

      <script is:inline>
        const gallery = document.getElementById("wweGallery");
        const button = document.getElementById("showGalleryButton");
        const slider = document.getElementById("wweSlider");
        const next = document.getElementById("nextSlide");
        const prev = document.getElementById("prevSlide");
        let index = 0;
        const slides = slider.children.length;

        // 🎬 Vis/skjul galleriet
        button.addEventListener("click", () => {
          gallery.classList.toggle("hidden");
          button.textContent = gallery.classList.contains("hidden") ? "See Photos" : "Hide Photos";
        });

        // ▶ Næste billede
        next.addEventListener("click", () => {
          index = (index + 1) % slides;
          slider.style.transform = `translateX(-${index * 100}%)`;
        });

        // ◀ Forrige billede
        prev.addEventListener("click", () => {
          index = (index - 1 + slides) % slides;
          slider.style.transform = `translateX(-${index * 100}%)`;
        });
      </script>
    </div>
  </div>
</Layout>
