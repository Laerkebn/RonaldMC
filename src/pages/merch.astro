              class="absolute top-[50%] right-[1%] w-[40%] object-contain z-50 group-hover:scale-110 transition-transform pointer-events-none"
              src="/merch/limited.svg"
              alt="Limited edition badge"
            />
            <div
              class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-all rounded-lg pointer-events-none"
            >
            </div>
          </div>
          <p class="mt-3 text-left text-base lg:text-lg font-semibold line-clamp-2">
            (Limited Edition) Haunted House Tour T-Shirt
