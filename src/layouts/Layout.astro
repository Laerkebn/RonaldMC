---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/Billeder/rackarackalogo.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Rackarack</title>
  </head>

  <body style="background-color: #6F6E70;" class="min-h-screen flex flex-col text-white m-0 p-0">
    <!-- Øverste sorte boks med mørkegrå "kant" -->
    <div class="w-full bg-[#272425]">
      <div class="rounded-lg m-5 p-[2px] bg-[#272425]">
        <!-- Dette giver "kanten" -->
        <div class="bg-black rounded-lg p-5 text-center">
          <!-- Rød håndskrevet tekst -->
          <img
            src="/Billeder/rackarackatekst.svg"
            alt="Rackaracka tekst"
            class="object-contain w-full h-24 sm:h-28 md:h-36 lg:h-40 xl:h-48 mb-4"
            style="transform: scaleX(2.5); transform-origin: center;"
          />

          <!-- Rødt spiral logo under teksten -->
          <div class="flex justify-center">
            <img src="/Billeder/rackarackalogo.svg" alt="Logo" class="w-28 object-contain" />
          </div>
        </div>
      </div>
    </div>

    <!-- Hovedindhold -->
    <div class="flex-grow flex flex-col items-center justify-start px-5">
      <!-- Navigation -->
      <nav
        class="bg-[#272425] text-[#d92727] flex flex-wrap justify-center gap-6 sm:gap-10 py-4 px-5 rounded-xl shadow-lg uppercase tracking-widest font-semibold w-full mt-5"
        style="text-shadow: 2px 2px 0 #000, -2px -2px 0 #000, 2px -2px 0 #000, -2px 2px 0 #000, 2px 0 0 #000, -2px 0 0 #000, 0 2px 0 #000, 0 -2px 0 #000;"
      >
        <a href="/" class="hover:text-yellow-500 transform transition duration-300 hover:scale-110"
          >Frontpage</a
        >
        <a
          href="/merch"
          class="hover:text-yellow-500 transform transition duration-300 hover:scale-110">Merch</a
        >
        <a
          href="/events"
          class="hover:text-yellow-500 transform transition duration-300 hover:scale-110">Events</a
        >
        <a
          href="/about"
          class="hover:text-yellow-500 transform transition duration-300 hover:scale-110"
          >About us</a
        >
        <a
          href="/contact"
          class="hover:text-yellow-500 transform transition duration-300 hover:scale-110">Contact</a
        >
      </nav>

      <!-- Indhold -->
      <main class="flex-grow mt-6 w-full max-w-5xl z-2 text-center sm:text-left">
        <slot />
      </main>
    </div>

    <!-- Nederste sorte boks med mørkegrå border -->
    <div class="w-full z-30 bg-[#272425] mt-10">
      <div class="rounded-lg m-5 text-center z-30">
        <!-- Bundsektion -->
        <div class="bg-black rounded-lg p-10 text-center ease-in-out relative">
          <h2 class="text-2xl sm:text-3xl font-bold mb-6 tracking-wider">
            Join the RackaRacka Family - Subscribe to our emails
          </h2>

          <!-- Input + knap -->
          <div
            class="flex items-center justify-center border border-gray-500 w-full sm:w-[600px] mx-auto px-6 py-4 relative"
          >
            <input
              id="emailInput"
              type="text"
              placeholder="Email"
              class="bg-transparent text-gray-300 outline-none w-full text-xl font-light tracking-widest text-center sm:text-left"
            />
            <button
              id="subscribeButton"
              class="text-gray-300 hover:scale-[1.02] text-2xl hover:translate-x-1 transition"
            >
              →
            </button>
          </div>

          <!-- Popup besked -->
          <div
            id="popupMessage"
            class="hidden absolute m-2 left-1/2 transform -translate-x-1/2 bg-green-600 text-white text-sm font-medium px-5 py-2 rounded-lg shadow-lg transition-opacity duration-300"
          >
            Your email has been added to the list
          </div>

          <!-- join -->
          <h2 class="text-3xl font-bold pt-5">Follow our socials</h2>
          <p class="text-lg text-gray-300 mb-6 max-w-xl mx-auto">
            Follow us as we continue to blow stuff up, make you laugh, and bring chaos from YouTube
            to the big screen.
          </p>

          <div class="flex flex-wrap justify-center gap-4">
            <!-- YouTube -->
            <a
              href="https://www.youtube.com/@Therackaracka"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center w-48 h-20 bg-red-600 hover:bg-red-700
                      text-white text-2xl font-bold rounded-lg transition transform hover:scale-105"
            >
              YouTube
            </a>

            <!-- Danny -->
            <a
              href="https://www.instagram.com/therackaracka/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center w-48 h-20 bg-gradient-to-r from-purple-600 to-pink-600
                      hover:from-purple-700 hover:to-pink-700 text-white font-bold rounded-lg
                      transition transform hover:scale-105 leading-tight"
            >
              <span class="text-2xl">Instagram</span>
              <span class="text-[12px] font-light leading-none">Danny Philippou</span>
            </a>

            <!-- Michael -->
            <a
              href="https://www.instagram.com/michael_philippou/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center w-48 h-20 bg-gradient-to-r from-purple-600 to-pink-600
                      hover:from-purple-700 hover:to-pink-700 text-white font-bold rounded-lg
                      transition transform hover:scale-105 leading-tight"
            >
              <span class="text-2xl">Instagram</span>
              <span class="text-[12px] font-light leading-none">Michael Philippou</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- subscribe script -->
    <script>
      const subscribeButton = document.getElementById("subscribeButton");
      const popupMessage = document.getElementById("popupMessage");
      const emailInput = document.getElementById("emailInput") as HTMLInputElement;

      if (subscribeButton && popupMessage && emailInput) {
        subscribeButton.addEventListener("click", () => {
          const email = emailInput.value.trim();

          if (email === "") {
            popupMessage.textContent = "Please enter a valid email";
            popupMessage.classList.remove("bg-green-600");
            popupMessage.classList.add("bg-red-600");
          } else {
            popupMessage.textContent = "Your email has been added to the list";
            popupMessage.classList.remove("bg-red-600");
            popupMessage.classList.add("bg-green-600");
            emailInput.value = "";
          }

          popupMessage.classList.remove("hidden");
          popupMessage.style.opacity = "1";

          setTimeout(() => {
            popupMessage.style.opacity = "0";
            setTimeout(() => popupMessage.classList.add("hidden"), 300);
          }, 3000);
        });
      }
    </script>
  </body>
</html>
